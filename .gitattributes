# Normalize line endings on commit
* text=auto

# Keep PowerShell scripts with CRLF on Windows checkout
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.exe binary
*.dll binary
*.db  binary
*.sqlite binary

# Vendored third-party files are served byte-for-byte under a subresource-integrity hash:
# a CRLF checkout on Windows changed the bytes and the browser refused the script (AG98)
src/atlas_plus/web/static/* -text

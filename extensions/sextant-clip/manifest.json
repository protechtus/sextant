{
  "manifest_version": 3,
  "name": "Sextant Clip",
  "version": "0.1.0",
  "description": "One click sends the current AI web chat (claude.ai, ChatGPT, Gemini, or any page) to your local Sextant memory.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "action": {
    "default_title": "Send this chat to Sextant"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  }
}
